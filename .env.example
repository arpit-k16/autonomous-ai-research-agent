# Copy to .env and fill in.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# groq | openai
LLM_PROVIDER=groq
# Default: openai/gpt-oss-120b.  Other free Groq options: openai/gpt-oss-20b, llama-3.1-8b-instant
CHAT_MODEL=openai/gpt-oss-120b

# Only if LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Free-tier friendly limits
MAX_RPM=10
MAX_ITER=10
SEARCH_RESULTS=4
PAGE_CHARS=2000
MAX_RETRIES=6
REASONING_EFFORT=low
